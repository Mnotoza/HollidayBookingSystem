@page "/AddBooking"
@model HollidayBookingSystem.UI.Pages.AddBookingModel
@{
    ViewData["Title"] = "Add Booking";
}

<h2>Add a New Booking</h2>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.CustomerName" class="form-label"></label>
        <input asp-for="Input.CustomerName" class="form-control" />
        <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Type" class="form-label"></label>
        <select asp-for="Input.Type" class="form-select">
            <option value="">-- Select Type --</option>
            <option>Apartment</option>
            <option>Vehicle</option>
            <option>Show</option>
        </select>
        <span asp-validation-for="Input.Type" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.BookingDate" class="form-label"></label>
        <input asp-for="Input.BookingDate" type="date" class="form-control" />
        <span asp-validation-for="Input.BookingDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
