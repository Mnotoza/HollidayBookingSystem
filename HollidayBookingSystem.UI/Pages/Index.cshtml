@page
@model HollidayBookingSystem.UI.Pages.IndexModel
@{
    ViewData["Title"] = "Bookings Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Holiday Bookings</h2>

    @if (Model.Bookings == null || !Model.Bookings.Any())
    {
        <div class="alert alert-info text-center">
            No bookings available. <a asp-page="/AddBooking" class="alert-link">Add a new booking</a>.
        </div>
    }
    else
    {
        <table class="table table-hover table-bordered shadow-sm">
            <thead class="table-primary">
                <tr>
                    <th>Customer</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.CustomerName</td>
                        <td>@booking.Type</td>
                        <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-page="/EditBooking" asp-route-id="@booking.Id" class="btn btn-secondary btn-sm">Edit</a>
                            <a asp-page="/DeleteBooking" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
