@page "{id:guid}"
@model HollidayBookingSystem.UI.Pages.EditBookingModel
@{
    ViewData["Title"] = "Edit Booking";
}

<h2>Edit Booking</h2>

<!-- Save form -->
<form method="post">
    <input type="hidden" asp-for="Input.Id" />

    <div class="mb-3">
        <label asp-for="Input.CustomerName" class="form-label"></label>
        <input asp-for="Input.CustomerName" class="form-control" />
        <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.BookingDate" class="form-label"></label>
        <input asp-for="Input.BookingDate" type="date" class="form-control" />
        <span asp-validation-for="Input.BookingDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
</form>

<!-- Separate Delete form -->
<form method="post" asp-page-handler="Delete" asp-route-id="@Model.Input.Id" style="margin-top:10px;">
    <button type="submit" class="btn btn-danger"
            onclick="return confirm('Are you sure you want to delete this booking?');">
        Delete
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
